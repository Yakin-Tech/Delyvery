NODE_ENV=development
PORT=5000

# Supabase project (Project Settings > API in the Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
# The "secret" / service_role key. Backend only — never send this to the frontend.
SUPABASE_SECRET_KEY=

# JWT (our own auth, separate from Supabase Auth)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the frontend dev server origin
CORS_ORIGIN=http://localhost:3000

# Seed script - first Super Admin login
SEED_SUPER_ADMIN_NAME=Platform Super Admin
SEED_SUPER_ADMIN_PHONE=9999999999
SEED_SUPER_ADMIN_PASSWORD=changeme123

# Seed script - demo organization + first org admin
SEED_ORG_NAME=Balu Water, Udumalpet
SEED_ORG_ADMIN_NAME=Balu
SEED_ORG_ADMIN_PHONE=9000000001
SEED_ORG_ADMIN_PASSWORD=changeme123
